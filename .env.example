# ---------------------------------------------------------------------------
# Jarz Digital — environment configuration
# Copy to .env.local for development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public base URL (used for canonical URLs, sitemap, emails, OG images)
SITE_URL=http://localhost:3000

# MongoDB (Atlas or self-hosted). Leave empty to preview the site with the
# built-in migrated content (admin, auth and forms require a database).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=jarzdigital

# Long random string (e.g. `openssl rand -base64 48`). Required in production.
AUTH_SECRET=
SESSION_TTL_DAYS=30
# Set to "false" to disable public client registration
ALLOW_REGISTRATION=true

# Email: console | smtp | resend | brevo
EMAIL_PROVIDER=console
EMAIL_FROM="Jarz Digital <no-reply@jarzdigital.com>"
ADMIN_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=
BREVO_API_KEY=

# Media storage: local | cloudinary | s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Optional: create the first admin during `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
