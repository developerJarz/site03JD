{
  "name": "jarz-digital-proposal-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "site:dev": "vite --config vite.site.config.ts --host 127.0.0.1 --port 5180",
    "site:build": "tsc -b && vite build --config vite.site.config.ts && vite build --config vite.site.config.ts --ssr ../src/site/entry-server.tsx --outDir ../dist-ssr --emptyOutDir && node scripts-prerender.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3"
  }
}